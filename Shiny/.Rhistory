geom_point(alpha = 1, size = 2) +
geom_label_repel(aes(fill=class), max.overlaps = Inf, size = 3) +
labs(x = "IV 30d", y = "Steepness") +scale_fill_brewer(palette = "Accent") + theme_bw(base_size = 18) + theme(legend.position = "None")
