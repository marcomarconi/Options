lfys[j,-1] <- c(LFY[c(10000, 12500, 15000, 20000)])
}
df <- rbind(cbind(data.frame(tfl1s, type="TFL1")), cbind(data.frame(lfys, type="LFY")))
df
df_ <- df %>% pivot_longer(-c(type, rep), names_to = "time")
df__ <- cbind(df__[1:4,-1], df__[5:8,-c(1,2)])
df__
df_
df__ <- df_ %>% group_by(type, time) %>% reframe(M=mean(value), S=sd(value))
df__ <- cbind(df__[1:4,-1], df__[5:8,-c(1,2)])
colnames(df__) <- c("time", "M_1", "S_1", "M_2", "S_2")
ggplot(df__) + geom_errorbar(aes(x=M_1, ymin=M_2-S_2, ymax=M_2+S_2, color=time), width=0.05) + geom_errorbarh(aes(y=M_2, xmin=M_1-S_1, xmax=M_1+S_1, color=time), height=0.05) + xlim(c(0,3)) + ylim(c(0,6))
ggplot(df__) + geom_errorbar(aes(x=M_1, ymin=M_2-S_2, ymax=M_2+S_2, color=time), width=0.05) + geom_errorbarh(aes(y=M_2, xmin=M_1-S_1, xmax=M_1+S_1, color=time), height=0.05) + xlim(c(0,3)) + ylim(c(0,6)) + theme(text = element_text(size=32)) + xlab("LFY") + xlab("TFL1")
ggplot(df__) + geom_errorbar(aes(x=M_1, ymin=M_2-S_2, ymax=M_2+S_2, color=time), width=0.05, linesize=2) + geom_errorbarh(aes(y=M_2, xmin=M_1-S_1, xmax=M_1+S_1, color=time), height=0.05) + xlim(c(0,3)) + ylim(c(0,6)) + theme(text = element_text(size=32)) + xlab("LFY") + ylab("TFL1")
ggplot(df__) + geom_errorbar(aes(x=M_1, ymin=M_2-S_2, ymax=M_2+S_2, color=time), width=0.05, size=2) + geom_errorbarh(aes(y=M_2, xmin=M_1-S_1, xmax=M_1+S_1, color=time), height=0.05) + xlim(c(0,3)) + ylim(c(0,6)) + theme(text = element_text(size=32)) + xlab("LFY") + ylab("TFL1")
ggplot(df__) + geom_errorbar(aes(x=M_1, ymin=M_2-S_2, ymax=M_2+S_2, color=time), width=0.05, size=2) + geom_errorbarh(aes(y=M_2, xmin=M_1-S_1, xmax=M_1+S_1, color=time), height=0.05, size=2) + xlim(c(0,3)) + ylim(c(0,6)) + theme(text = element_text(size=32)) + xlab("LFY") + ylab("TFL1")
