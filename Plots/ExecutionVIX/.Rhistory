J <- 30
tfl1s <- matrix(NA, nrow=J, ncol=5); tfl1s[,1] <- 1:J; colnames(tfl1s) <- c("rep", paste0("t", 1:4))
lfys <- matrix(NA, nrow=J, ncol=5); lfys[,1] <- 1:J; colnames(lfys) <- c("rep", paste0("t", 1:4))
for(j in 1:J)
{
N <- 20000
dt <- 0.01
TFL1 <- rep(0, N)
LFY <- rep(0, N)
TFL1[1] <- 0
LFY[1] <- 0
#FRP <- (create_triangle_wave(N, N/1) * -1 + 1) * 1
FRP <- rep(0, N)
FRP[10001:12500] <- 0.2
FRP[12501:15000] <- 0.75#seq(1, 0.01, length.out=length(10001:20000)) * 0.2
FRP[15001:20000] <- 0.1
#FRP[10001:20000] <- (create_triangle_wave(N/2, N/2) * -1 + 1) * 0.1
bTFL1 <- 0.1+runif(1, -0.02, 0.02)
bLFY <- 0.1+runif(1, -0.02, 0.02)
frpLFY <- 1
frpTFL1 <- 0
rTFL1 <- 1
rLFY <- 1
dTFL1 <- 0.1
dLFY <- 0.1
delay <- 50
for(i in (delay+1):N){
LFY[i] <- LFY[i-1] + (bLFY + FRP[i]*frpLFY - 1*hill(TFL1[i-delay], 4, 8) - dLFY * LFY[i-1]) * dt
TFL1[i] <- TFL1[i-1] + (bTFL1 + FRP[i]*frpTFL1 + 1*hill(LFY[i-delay], 3, 8)  - dTFL1 * TFL1[i-1]) * dt
}
#matplot(cbind(TFL1, LFY, FRP), type="l")
plot(LFY[1:(N/1)], TFL1[1:(N/1)])
#points(LFY[(N/2):N], TFL1[(N/2):N], col="red", xlim=c(0, 10), ylim=c(0, 10))
tfl1s[j,-1] <- c(TFL1[c(10000, 12500, 15000, 20000)])
lfys[j,-1] <- c(LFY[c(10000, 12500, 15000, 20000)])
}
df <- rbind(cbind(data.frame(tfl1s, type="TFL1")), cbind(data.frame(lfys, type="LFY")))
df_ <- df %>% pivot_longer(-c(type, rep), names_to = "time")
df__ <- cbind(df__[1:4,-1], df__[5:8,-c(1,2)])
colnames(df__) <- c("time", "M_1", "S_1", "M_2", "S_2")
