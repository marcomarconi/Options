LFY[i] <- LFY[i-1] + (bLFY + FRP[i]*frpLFY - 1*hill(TFL1[i-delay], 4, 8) - dLFY * LFY[i-1]) * dt
TFL1[i] <- TFL1[i-1] + (bTFL1 + FRP[i]*frpTFL1 + 1*hill(LFY[i-delay], 3, 8)  - dTFL1 * TFL1[i-1]) * dt
}
